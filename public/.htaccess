# ============================================================
# PWA Apache configuration for virtual-3phase-meter
# ============================================================

# --- MIME Types ---
<IfModule mod_mime.c>
    AddType application/manifest+json  .json
    AddType font/woff2                 .woff2
    AddType image/svg+xml              .svg
</IfModule>

# --- Headers (requires mod_headers) ---
<IfModule mod_headers.c>
    # manifest.json must be served as application/manifest+json
    <FilesMatch "manifest\.json$">
        Header set Content-Type "application/manifest+json; charset=utf-8"
    </FilesMatch>

    # Service worker must never be HTTP-cached.
    # If the browser caches sw.js, PWA updates won't roll out.
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# --- Cache lifetimes for static assets ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/manifest+json  "access plus 1 week"
    ExpiresByType image/png                  "access plus 1 month"
    ExpiresByType image/svg+xml              "access plus 1 month"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType text/css                   "access plus 1 week"
    ExpiresByType application/javascript     "access plus 1 week"
</IfModule>
